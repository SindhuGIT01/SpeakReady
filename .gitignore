# Environments & secrets
venv/
.venv/
.env

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Vector store & local DB
chroma_db/
*.db
*.sqlite3

# MediaPipe model bundles (downloaded on first use, not trained in this repo)
models/*.task

# Audio files
audio/
*.wav
*.mp3
*.m4a
*.ogg
*.flac
*.webm

# Sample audio fixture (kept for tests)
!tests/fixtures/*.mp3

# User resumes (keep folder only)
data/resumes/*
!data/resumes/.gitkeep

# Cached local Whisper transcripts for model training (regenerable)
data/whisper_cache/

# Notebooks / editors / OS
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db
